
.review-company {
  word-break: break-all;
  margin-right: 12rpx;
}

.review-position {
  margin-top: 4rpx;
  font-size: var(--text-secondary);
  word-break: break-all;
}

.review-metadata {
  display: flex;
  flex-direction: row;
}

.review-field {
  flex: 1;
  min-width: 0;
}

.review-date {
  margin-left: 20rpx;
}

.review-empty {
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}

.question-card {
  margin-bottom: 20rpx;
}

.question-title {
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 650;
}

.question-remove {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  box-sizing: border-box;
  margin: -8px -8px -8px 0;
  padding: 0 8px;
  color: var(--danger);
  font-size: var(--text-secondary);
  font-weight: 600;
}

.review-question-input {
  height: 72px;
}

.review-score-label {
  color: var(--warning);
  font-size: var(--text-secondary);
  font-weight: 650;
}

.review-stars {
  display: flex;
  flex-direction: row;
}

.review-star {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  margin-right: 8rpx;
  border-radius: var(--radius-sm);
  background-color: var(--surface-muted);
}

.review-star-selected {
  background-color: var(--warning-soft);
}