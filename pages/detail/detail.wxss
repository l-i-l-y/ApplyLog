
.detail-hero {
  padding: 24rpx;
}

.detail-demo {
  margin-left: 8rpx;
}

.detail-company {
  margin-top: 16rpx;
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 750;
  line-height: 1.2;
  word-break: break-all;
}

.detail-position {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 28rpx;
  word-break: break-all;
}

.detail-meta {
  margin-top: 16rpx;
}

.detail-meta-item {
  margin: 0 8rpx 8rpx 0;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  background-color: #F1F3F9;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.25;
}

.detail-note {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 26rpx;
  word-break: break-all;
}

.detail-job-link {
  padding: 16rpx 0 0;
}

.status-steps {
  display: flex;
  flex-direction: row;
  margin: 16rpx 0;
}

.status-step {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.status-step-track {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
}

.status-step-line {
  flex: 1;
  height: 4rpx;
  background-color: var(--line);
}

.status-line-hidden {
  opacity: 0;
}

.status-step-node {
  width: 24rpx;
  height: 24rpx;
  border-width: 4rpx;
  border-style: solid;
  border-color: #C4CBDB;
  border-radius: 50%;
  background-color: var(--surface);
}

.status-step-label {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.25;
}

.status-step-active {
  font-weight: 750;
}

.status-note {
  height: 72rpx;
  font-size: 24rpx;
}

.reminder-form {
  margin-bottom: 16rpx;
}

.reminder-form-pair {
  display: flex;
  flex-direction: row;
}

.reminder-form-half {
  flex: 1;
  min-width: 0;
}

.reminder-form-second {
  margin-left: 16rpx;
}

.reminder-save {
  margin-top: 24rpx;
}

.detail-reminder,
.detail-review {
  margin-bottom: 16rpx;
}

.reminder-actions {
  align-items: center;
  margin: 0 16rpx;
  padding-top: 8rpx;
  border-top-width: 2rpx;
  border-top-style: solid;
  border-top-color: var(--line);
}

.reminder-action {
  margin: 0 8rpx 8rpx 0;
}

.detail-review-copy,
.timeline-content {
  display: flex;
  flex-direction: column;
}

.detail-review-round {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 650;
}

.timeline-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.timeline-row-separated {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top-width: 2rpx;
  border-top-style: solid;
  border-top-color: var(--line);
}

.timeline-dot {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  margin: 8rpx 16rpx 0 0;
  border-radius: 50%;
}

.timeline-status {
  font-size: 26rpx;
  font-weight: 650;
}

.timeline-time {
  margin-left: 16rpx;
  text-align: right;
}

.timeline-note {
  margin-top: 8rpx;
  word-break: break-all;
}
