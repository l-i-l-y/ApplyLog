
.home-content {
  padding-top: 16rpx;
}

.home-guide {
  margin-bottom: 32rpx;
}

.home-guide-head {
  margin-bottom: 4rpx;
}

.home-guide-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  margin-right: 16rpx;
  border-radius: var(--radius-sm);
  background-color: var(--primary-soft);
}

.home-guide-copy {
  margin-top: 16rpx;
}

.home-guide-actions {
  margin-top: 28rpx;
}

.home-guide-ok {
  margin-left: 16rpx;
}

.home-greeting {
  align-items: baseline;
  margin: 8rpx 0 24rpx;
}

.home-heading {
  color: var(--ink);
  font-size: var(--text-h1);
  font-weight: 700;
  line-height: 1.35;
}

.home-date {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.home-summary {
  padding: 32rpx;
}

.home-summary-header {
  min-height: 44px;
  margin: -8px 0 0;
}

.home-summary-label {
  color: var(--muted);
  font-size: var(--text-secondary);
  font-weight: 600;
}

.week-control {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  min-width: 44px;
  min-height: 44px;
  margin-right: -4px;
}

.week-chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 28px;
  padding: 0 8px 0 12px;
  border-radius: 999px;
  background-color: var(--primary-soft);
  color: var(--primary-strong);
  font-size: var(--text-caption);
  font-weight: 600;
}

.week-info {
  margin-left: 4px;
}

.home-total {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin: 0 0 24rpx;
}

.home-number {
  color: var(--ink);
  font-size: var(--text-display);
  font-weight: 700;
  line-height: 1.15;
}

.home-unit {
  margin-left: 6px;
  color: var(--muted);
  font-size: var(--text-body);
  font-weight: 500;
}

.distribution-track {
  display: flex;
  flex-direction: row;
  width: 100%;
  height: 8px;
  overflow: hidden;
  border-radius: 999px;
  background-color: var(--surface-muted);
}

.distribution-piece {
  height: 8px;
}

.distribution-legend {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.legend-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 50%;
  min-height: 28px;
}

.legend-dot {
  flex-shrink: 0;
  width: 8px;
  height: 8px;
  margin-right: 8px;
  border-radius: 50%;
}

.legend-label {
  color: var(--muted);
  font-size: var(--text-caption);
}

.legend-count {
  margin-left: 8px;
  color: var(--ink);
  font-size: var(--text-caption);
  font-weight: 650;
}

.distribution-empty {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: var(--text-caption);
  line-height: 1.55;
}

.home-add {
  margin-top: 24rpx;
}

.schedule-panel {
  padding: 0 8rpx;
}

.schedule-row,
.recent-row {
  display: flex;
  flex-direction: column;
}

.schedule-row-separator {
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: var(--line);
}

.schedule-empty {
  padding: 24rpx 20rpx;
}

.schedule-empty-symbol {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  margin-right: 20rpx;
  border-radius: var(--radius-sm);
  background-color: var(--primary-soft);
}

.schedule-empty-copy {
  display: flex;
  flex-direction: column;
}

.schedule-empty-title {
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 600;
  line-height: 1.4;
}

.home-overdue {
  padding: 0 8rpx;
}

.overdue-toggle {
  min-height: 52px;
  padding: 0 20rpx;
}

.overdue-heading {
  color: var(--danger);
  font-size: var(--text-body);
  font-weight: 600;
}

.overdue-open {
  transform: rotate(180deg);
}

.home-more {
  padding-left: 16rpx;
}

.recent-row {
  margin-bottom: 16rpx;
}