
.list-controls {
  display: flex;
  flex-direction: column;
  padding: 16rpx 32rpx 8rpx;
}

.list-search {
  box-sizing: border-box;
  min-height: 46px;
  padding: 0 0 0 24rpx;
  border-width: 1px;
  border-style: solid;
  border-color: var(--line-strong);
  border-radius: var(--radius);
  background-color: var(--surface);
}

.search-mark {
  margin-right: 16rpx;
}

.search-input {
  height: 44px;
  color: var(--ink);
  font-size: var(--text-body);
}

.search-placeholder {
  color: var(--subtle);
}

.search-clear {
  margin-left: 4px;
}

/* 7 个筛选标签保持单行，超出时横向滚动。 */
.list-filters {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  width: 100%;
  /* Skyline 横向列表会把标签拉伸到容器高度，容器高度即标签热区。 */
  height: 44px;
  margin-top: 24rpx;
}

.list-filter-chip {
  flex-shrink: 0;
  margin-bottom: 0;
  white-space: nowrap;
}

.list-heading {
  margin-top: 20rpx;
}

.list-heading-copy {
  align-items: baseline;
}

.list-count {
  margin-left: 16rpx;
}

.list-create {
  padding-left: 16rpx;
}

.list-row {
  display: flex;
  flex-direction: column;
  margin: 0 32rpx 20rpx;
}

.list-bottom {
  height: 24rpx;
}