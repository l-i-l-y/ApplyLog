
page {
  --background: #F6F7FB;
  --surface: #FFFFFF;
  --primary: #4460E4;
  --primary-strong: #3E55D4;
  --primary-soft: #EBEFFF;
  --ink: #192439;
  --muted: #566177;
  --subtle: #657088;
  --line: #E7EAF2;
  --danger: #A13D51;
  --danger-soft: #FFF0F3;
  --radius: 24rpx;
  background-color: var(--background);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.45;
}

.page-shell {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: var(--background);
}

.page-nav {
  flex-shrink: 0;
}

.page-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.page-content {
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx 40rpx;
}

.page-content-safe {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.surface {
  display: flex;
  flex-direction: column;
  background-color: var(--surface);
  border-radius: var(--radius);
  box-shadow: 0 8rpx 24rpx rgba(36, 51, 96, 0.055);
}

.panel {
  padding: 24rpx;
}

.section {
  margin-top: 24rpx;
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.row-wrap {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.grow {
  flex: 1;
  min-width: 0;
}

.title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.subtle {
  color: var(--subtle);
  font-size: 24rpx;
}

.link {
  color: var(--primary-strong);
  font-size: 24rpx;
  font-weight: 600;
}

.demo-pill {
  flex-shrink: 0;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background-color: #EEF0F4;
  color: #565F71;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1.5;
}

.button {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--radius);
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.25;
}

.button-primary {
  background-color: var(--primary);
  color: #FFFFFF;
  box-shadow: 0 8rpx 16rpx rgba(79, 110, 247, 0.2);
}

.button-soft {
  background-color: var(--primary-soft);
  color: var(--primary-strong);
}

.button-danger {
  background-color: var(--danger-soft);
  color: var(--danger);
}

.button-small {
  min-height: 80rpx;
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.is-pressed {
  opacity: 0.72;
}

.card-pressed {
  opacity: 0.75;
}

.chip {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  min-height: 80rpx;
  margin: 0 8rpx 8rpx 0;
  padding: 8rpx 16rpx;
  border-radius: 32rpx;
  background-color: #EDF0F6;
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 550;
  line-height: 1.2;
}

.chip-selected {
  background-color: var(--primary-soft);
  color: var(--primary-strong);
  font-weight: 700;
}

.field {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 8rpx;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 650;
}

.field-input,
.field-textarea,
.field-picker {
  width: 100%;
  box-sizing: border-box;
  border-width: 2rpx;
  border-style: solid;
  border-color: var(--line);
  border-radius: 16rpx;
  background-color: #F8F9FC;
  color: var(--ink);
  font-size: 28rpx;
}

.field-input {
  height: 84rpx;
  padding: 0 16rpx;
}

.field-textarea {
  height: 144rpx;
  padding: 16rpx;
}

.field-picker {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: 8rpx 16rpx;
}

.field-invalid {
  border-color: #C85165;
  background-color: var(--danger-soft);
}

.field-error {
  margin-top: 8rpx;
  color: var(--danger);
  font-size: 24rpx;
}

.required-mark {
  color: var(--primary-strong);
}

.form-actions {
  flex-shrink: 0;
  padding: 8rpx 32rpx calc(8rpx + env(safe-area-inset-bottom));
  border-top-width: 2rpx;
  border-top-style: solid;
  border-top-color: var(--line);
  background-color: var(--surface);
}

.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
  color: var(--muted);
  font-size: 26rpx;
}

/* 键盘留位使用 px，不叠加安全区。 */
.keyboard-actions {
  padding-bottom: 8rpx;
}

.keyboard-space {
  flex-shrink: 0;
}
