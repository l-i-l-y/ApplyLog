/*
 * 投递有数视觉基础：颜色、字号、间距、圆角集中定义。
 * 字号与热区用 px，避免 rpx 在 320px 窄屏把文字和点击区缩小；留白用 rpx。
 */
page {
  --background: #F4F6FA;
  --surface: #FFFFFF;
  --surface-muted: #F1F3F7;
  --primary: #3B57D4;
  --primary-strong: #2E47BA;
  --primary-soft: #ECF0FE;
  --ink: #1A2338;
  --muted: #535D73;
  --subtle: #636D84;
  --line: #E6E9F0;
  --line-strong: #D5DAE4;
  --danger: #B03A50;
  --danger-soft: #FDEEF1;
  --warning: #93500F;
  --warning-soft: #FDF0DF;
  --radius-lg: 28rpx;
  --radius: 20rpx;
  --radius-sm: 14rpx;
  --shadow: 0 2px 10px rgba(26, 35, 56, 0.05);
  --text-display: 34px;
  --text-h1: 22px;
  --text-h2: 17px;
  --text-body: 15px;
  --text-secondary: 14px;
  --text-caption: 13px;
  --text-tag: 12px;
  --touch: 44px;
  background-color: var(--background);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: var(--text-body);
  line-height: 1.5;
}

.page-shell {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: var(--background);
}

.page-nav {
  flex-shrink: 0;
}

.page-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.page-content {
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx 48rpx;
}

.page-content-safe {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* 卡片只用一层轻阴影；嵌套内容用分隔线或浅底，不再叠加阴影。 */
.surface {
  display: flex;
  flex-direction: column;
  background-color: var(--surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}

.panel {
  padding: 32rpx;
}

.section {
  margin-top: 32rpx;
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: var(--touch);
  margin-bottom: 12rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.row-wrap {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.grow {
  flex: 1;
  min-width: 0;
}

/* 文字类只定义颜色与字号，不改变 display 和对齐，避免覆盖按钮布局。 */
.title {
  color: var(--ink);
  font-size: var(--text-h2);
  font-weight: 650;
  line-height: 1.35;
}

.muted {
  color: var(--muted);
  font-size: var(--text-caption);
  line-height: 1.55;
}

.subtle {
  color: var(--subtle);
  font-size: var(--text-caption);
  line-height: 1.55;
}

.link {
  color: var(--primary-strong);
  font-size: var(--text-secondary);
  font-weight: 600;
}

.paragraph {
  display: block;
  font-size: var(--text-secondary);
  line-height: 1.75;
}

.break-text {
  word-break: break-all;
}

.demo-pill {
  flex-shrink: 0;
  padding: 0 12rpx;
  border-radius: 999px;
  background-color: var(--surface-muted);
  color: var(--muted);
  font-size: var(--text-tag);
  font-weight: 600;
  line-height: 20px;
}

.icon {
  display: block;
  flex-shrink: 0;
  width: 20px;
  height: 20px;
}

.icon-sm {
  width: 16px;
  height: 16px;
}

.icon-lg {
  width: 24px;
  height: 24px;
}

.icon-before {
  margin-right: 6px;
}

.icon-after {
  margin-left: 2px;
}

/* 纯图标按钮：图标可以小，热区固定 44×44px。 */
.icon-button {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--touch);
  height: var(--touch);
  border-radius: var(--radius);
}

.text-action {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  min-height: var(--touch);
  color: var(--primary-strong);
  font-size: var(--text-secondary);
  font-weight: 600;
}

.button {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 8rpx 32rpx;
  border-radius: var(--radius);
  font-size: var(--text-body);
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
}

.button-primary {
  background-color: var(--primary);
  color: #FFFFFF;
}

.button-soft {
  background-color: var(--primary-soft);
  color: var(--primary-strong);
}

.button-secondary {
  background-color: var(--surface-muted);
  color: var(--ink);
}

.button-danger {
  background-color: var(--danger-soft);
  color: var(--danger);
}

.button-small {
  min-height: var(--touch);
  padding: 4rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: var(--text-secondary);
}

.is-pressed {
  opacity: 0.7;
}

.card-pressed {
  opacity: 0.8;
}

.chip {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  min-height: var(--touch);
  margin: 0 12rpx 12rpx 0;
  padding: 0 28rpx;
  border-width: 1px;
  border-style: solid;
  border-color: var(--line-strong);
  border-radius: 999px;
  background-color: var(--surface);
  color: var(--muted);
  font-size: var(--text-secondary);
  font-weight: 500;
  line-height: 1.2;
}

.chip-selected {
  border-color: var(--primary);
  background-color: var(--primary-soft);
  color: var(--primary-strong);
  font-weight: 650;
}

.field {
  display: flex;
  flex-direction: column;
  margin-top: 28rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: var(--ink);
  font-size: var(--text-secondary);
  font-weight: 600;
  line-height: 1.4;
}

.field-input,
.field-textarea,
.field-picker {
  width: 100%;
  box-sizing: border-box;
  border-width: 1px;
  border-style: solid;
  border-color: var(--line-strong);
  border-radius: var(--radius-sm);
  background-color: var(--surface);
  color: var(--ink);
  font-size: var(--text-body);
}

.field-input {
  height: 46px;
  padding: 0 24rpx;
}

.field-textarea {
  height: 96px;
  padding: 20rpx 24rpx;
  line-height: 1.6;
}

.field-picker {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 46px;
  padding: 8rpx 20rpx 8rpx 24rpx;
}

.field-invalid {
  border-color: var(--danger);
  background-color: var(--danger-soft);
}

.field-error {
  margin-top: 8rpx;
  color: var(--danger);
  font-size: var(--text-caption);
}

.required-mark {
  color: var(--danger);
}

.form-actions {
  flex-shrink: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: var(--line);
  background-color: var(--surface);
}

.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
  color: var(--muted);
  font-size: var(--text-secondary);
}

.callout {
  display: block;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-sm);
  background-color: var(--surface-muted);
  color: var(--muted);
  font-size: var(--text-caption);
  line-height: 1.6;
}

.callout-danger {
  background-color: var(--danger-soft);
  color: var(--danger);
}

/* 键盘留位使用 px，不叠加安全区。 */
.keyboard-actions {
  padding-bottom: 16rpx;
}

.keyboard-space {
  flex-shrink: 0;
}