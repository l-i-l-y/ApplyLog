
.empty-state {
  align-items: center;
  justify-content: center;
  padding: 28rpx 24rpx;
}

.empty-symbol {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 8rpx;
  border-radius: 24rpx;
  background-color: var(--primary-soft);
  color: var(--primary-strong);
  font-size: 36rpx;
  font-weight: 650;
}

.empty-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.empty-description {
  margin-top: 8rpx;
  text-align: center;
}

.empty-action {
  margin-top: 16rpx;
}
