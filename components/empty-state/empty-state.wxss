
.empty-state {
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
}

.empty-symbol {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  margin-bottom: 20rpx;
  border-radius: 50%;
  background-color: var(--primary-soft);
}

.empty-symbol-danger {
  background-color: var(--danger-soft);
}

.empty-title {
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 650;
  line-height: 1.4;
  text-align: center;
}

.empty-description {
  margin-top: 8rpx;
  font-size: var(--text-secondary);
  text-align: center;
  word-break: break-all;
}

.empty-action {
  margin-top: 28rpx;
}