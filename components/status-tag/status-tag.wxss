
.status-tag {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 24px;
  padding: 0 10px 0 8px;
  border-radius: 999px;
  font-size: var(--text-tag);
  font-weight: 600;
  line-height: 24px;
  white-space: nowrap;
}

.status-tag-dot {
  width: 6px;
  height: 6px;
  margin-right: 6px;
  border-radius: 50%;
}