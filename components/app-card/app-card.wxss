
.app-card {
  padding: 28rpx 24rpx 28rpx 28rpx;
}

.app-card-compact {
  padding: 24rpx 24rpx 24rpx 28rpx;
}

.app-card-main {
  align-items: flex-start;
}

.app-card-mark {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  margin-right: 24rpx;
  border-radius: var(--radius-sm);
  background-color: var(--primary-soft);
  color: var(--primary-strong);
  font-size: 17px;
  font-weight: 650;
}

.app-card-copy {
  display: flex;
  flex-direction: column;
  min-height: 40px;
  justify-content: center;
}

.app-card-name {
  align-items: flex-start;
}

.app-card-demo {
  margin: 1px 8rpx 0 0;
}

/* 长公司名、岗位名完整换行显示，不截断。 */
.app-card-company,
.app-card-position {
  word-break: break-all;
}

.app-card-company {
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 650;
  line-height: 1.4;
}

.app-card-position {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: var(--text-secondary);
  line-height: 1.45;
}

.app-card-side {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.app-card-menu {
  margin: -6px -8px -6px 0;
}

.app-card-footer {
  flex-wrap: wrap;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: var(--line);
}

.app-card-date {
  margin-right: 16rpx;
}

.app-card-next {
  min-width: 0;
  max-width: 100%;
}

.app-card-next-text {
  min-width: 0;
  color: var(--primary-strong);
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: 1.5;
}