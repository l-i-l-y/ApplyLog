<view class="weui-navigation-bar {{extClass}}" aria-hidden="{{!show}}">
  <view class="weui-navigation-bar__inner" style="{{displayStyle}}">
    <view class="weui-navigation-bar__status" style="height: {{statusHeight}}px;"></view>
    <view class="weui-navigation-bar__content" style="height: {{contentHeight}}px;">
      <view class="weui-navigation-bar__left" style="left: {{leftInset}}px; max-width: {{sideInset - leftInset - 8}}px;">
        <block wx:if="{{back || homeButton}}">
          <view wx:if="{{back}}" bindtap="back" class="weui-navigation-bar__btn_goback_wrapper" hover-class="weui-active" hover-stay-time="100" aria-role="button" aria-label="返回">
            <view class="weui-navigation-bar__button weui-navigation-bar__btn_goback"></view>
          </view>
          <view wx:if="{{homeButton}}" bindtap="home" class="weui-navigation-bar__btn_home_wrapper" hover-class="weui-active" hover-stay-time="100" aria-role="button" aria-label="首页">
            <view class="weui-navigation-bar__button weui-navigation-bar__btn_home"></view>
          </view>
        </block>
        <block wx:else>
          <slot name="left"></slot>
        </block>
      </view>
      <view class="weui-navigation-bar__center {{loading ? 'weui-navigation-bar__center_loading' : ''}}" style="left: {{sideInset}}px; right: {{sideInset}}px;">
        <view wx:if="{{loading}}" class="weui-navigation-bar__loading" aria-role="alert">
          <view class="weui-loading" aria-role="img" aria-label="加载中"></view>
        </view>
        <text wx:if="{{title}}" class="weui-navigation-bar__title">{{title}}</text>
        <block wx:else>
          <slot name="center"></slot>
        </block>
      </view>
      <view class="weui-navigation-bar__right" style="right: {{capsuleInset}}px; max-width: {{rightSlotMaxWidth}}px;">
        <slot name="right"></slot>
      </view>
    </view>
  </view>
</view>
