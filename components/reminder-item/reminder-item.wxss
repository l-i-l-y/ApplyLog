
.reminder-item {
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx;
}

.reminder-compact {
  padding: 20rpx 20rpx;
}

.reminder-main {
  align-items: flex-start;
}

.reminder-symbol {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  margin-right: 20rpx;
  border-radius: var(--radius-sm);
}

.reminder-interview {
  background-color: var(--warning-soft);
}

.reminder-followup {
  background-color: var(--primary-soft);
}

.reminder-copy,
.reminder-when,
.reminder-extra {
  display: flex;
  flex-direction: column;
}

.reminder-copy {
  min-height: 36px;
  justify-content: center;
}

.reminder-title,
.reminder-subtitle {
  word-break: break-all;
}

.reminder-title {
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 600;
  line-height: 1.4;
}

.reminder-subtitle {
  margin-top: 2rpx;
  color: var(--muted);
  font-size: var(--text-caption);
  line-height: 1.45;
}

.reminder-when {
  flex-shrink: 0;
  align-items: flex-end;
  min-height: 36px;
  justify-content: center;
  margin-left: 16rpx;
}

.reminder-time {
  color: var(--primary-strong);
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: 1.45;
}

.reminder-time-done {
  color: var(--subtle);
  font-weight: 500;
}

.reminder-state {
  color: var(--subtle);
  font-size: var(--text-tag);
  line-height: 1.45;
}

.reminder-overdue {
  color: var(--danger);
}

.reminder-extra {
  margin: 16rpx 0 0 56px;
  color: var(--muted);
  font-size: var(--text-caption);
  line-height: 1.6;
  word-break: break-all;
}
